<?xml version="1.0"?>
<!-- engram: TurtleBot3 Waffle base with an SO-101 follower arm.

     The base is the stock Waffle model from turtlebot3_description, included
     unchanged, so its frames (base_footprint, base_link, base_scan, ...) match
     the TurtleBot3 stack. base_link sits on the wheel axle; +x is forward.

     Two layouts (see README.md for the numbers):
       - top_deck:=true (default): an extra plate (top_deck_link) sits
         deck_spacing above the Waffle top plate. The LDS stays on the Waffle
         top plate, now the level below the deck. The arm stands on the deck
         with its pan axis over the robot's centre, leaving the front of the
         deck free for the pan-tilt camera.
       - top_deck:=false: no extra plate; the arm sits on the Waffle top plate
         over the wheel axle, just ahead of the LDS.

     In both, y = 0 centres the arm (its base is symmetric about its own x
     axis), and arm base_link is 2.4 mm above the underside of the arm base.
     arm_x overrides the default x for either layout, to line the arm base's
     diamond cutouts up with the plate holes. -->
<robot name="engram" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="top_deck" default="true"/>
  <!-- 45 mm (stock) puts the deck 3.5 mm into the LDS; 55 mm clears it by 6.5 mm -->
  <xacro:arg name="deck_spacing" default="0.055"/>
  <xacro:arg name="arm_x" default=""/>
  <xacro:arg name="arm_y" default="0.0"/>
  <xacro:arg name="arm_yaw" default="0.0"/>

  <xacro:property name="top_deck" value="$(arg top_deck)"/>
  <xacro:property name="arm_x_override" value="$(arg arm_x)"/>

  <xacro:property name="waffle_top_plate_z" value="0.0915"/>
  <!-- Waffle footprint centre in base_link, from turtlebot3_waffle.urdf's collision box -->
  <xacro:property name="waffle_centre_x" value="-0.064"/>
  <xacro:property name="waffle_plate_size" value="0.266"/>
  <!-- Waffle plates are ribbed: underside is 9 mm below the top surface -->
  <xacro:property name="plate_thickness" value="0.009"/>
  <xacro:property name="so101_base_underside_z" value="-0.0024"/>
  <!-- Shoulder pan axis in SO-101 base_link, from so101_new_calib.urdf -->
  <xacro:property name="so101_pan_axis_x" value="0.0388"/>

  <xacro:include filename="$(find turtlebot3_description)/urdf/turtlebot3_waffle.urdf"/>
  <xacro:include filename="$(find engram_description)/urdf/so101_follower.urdf.xacro"/>

  <xacro:if value="${top_deck}">
    <!-- Pan axis over the Waffle centre. top_deck_link is already centred and on
         the plate surface, so the origin is relative to it. -->
    <xacro:property name="arm_parent" value="top_deck_link"/>
    <xacro:property name="arm_x" value="${float(arm_x_override) if arm_x_override != '' else waffle_centre_x - so101_pan_axis_x}"/>
    <xacro:property name="arm_origin_x" value="${arm_x - waffle_centre_x}"/>
    <xacro:property name="arm_origin_z" value="${-so101_base_underside_z}"/>

    <!-- top_deck_link sits on the deck's top surface, above the Waffle centre.
         deck_spacing is top surface to top surface, like the Waffle's own levels
         (45 mm apart). -->
    <joint name="top_deck_joint" type="fixed">
      <parent link="base_link"/>
      <child link="top_deck_link"/>
      <origin xyz="${waffle_centre_x} 0 ${waffle_top_plate_z + $(arg deck_spacing)}" rpy="0 0 0"/>
    </joint>

    <link name="top_deck_link">
      <!-- Same plate as the Waffle's other levels, cut from waffle_base.stl.
           Its top surface is at z = 91.5 mm in that mesh. -->
      <visual>
        <origin xyz="0 0 ${-waffle_top_plate_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://engram_description/meshes/waffle/waffle_plate.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="light_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-plate_thickness / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="${waffle_plate_size} ${waffle_plate_size} ${plate_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-plate_thickness / 2}" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="8.8e-04" ixy="0" ixz="0" iyy="8.8e-04" iyz="0" izz="1.8e-03"/>
      </inertial>
    </link>
  </xacro:if>

  <xacro:unless value="${top_deck}">
    <!-- Arm base rear edge 3 mm ahead of the LDS front (x = -3.2 mm) -->
    <xacro:property name="arm_parent" value="base_link"/>
    <xacro:property name="arm_origin_x" value="${float(arm_x_override) if arm_x_override != '' else 0.0222}"/>
    <xacro:property name="arm_origin_z" value="${waffle_top_plate_z - so101_base_underside_z}"/>
  </xacro:unless>

  <xacro:so101_follower prefix="arm_" parent="${arm_parent}">
    <origin xyz="${arm_origin_x} $(arg arm_y) ${arm_origin_z}" rpy="0 0 $(arg arm_yaw)"/>
  </xacro:so101_follower>

</robot>
