extends: default

rules:
  line-length:
    max: 120
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on"]  # "on" is the GitHub Actions trigger key
  comments:
    min-spaces-from-content: 1
  # Settings ansible-lint requires of a shared yamllint config.
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
